{
  "name": "tma-shop-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "supabase"]
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "tsx scripts/dev-local.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:bundle-secrets": "tsx scripts/check-bundle-secrets.ts",
    "check:tenant-names": "tsx scripts/check-tenant-names.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:tenant-names",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:start": "tsx scripts/supabase-start.ts",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "tenant:new": "tsx scripts/tenant/new.ts",
    "tenant:validate": "tsx scripts/tenant/validate.ts",
    "tenant:seed": "tsx scripts/tenant/seed.ts",
    "tenant:publish": "tsx scripts/tenant/publish.ts",
    "tenant:verify": "tsx scripts/tenant/verify.ts",
    "owner:add": "tsx scripts/owner-add.ts",
    "dev:tg-link": "tsx scripts/dev-telegram-link.ts",
    "telegram:mock": "tsx scripts/telegram-mock.ts",
    "dev:demo-accounts": "tsx scripts/dev-demo-accounts.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tma.js/sdk-react": "^3.0.23",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
