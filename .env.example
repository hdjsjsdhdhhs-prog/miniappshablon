# ---------------------------------------------------------------------------
# Frontend (public, embedded into the bundle). Only publishable values!
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# anon / publishable key — protected by RLS, safe for the browser
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# ---------------------------------------------------------------------------
# Tenant pipeline & admin scripts (shell env of the operator, NEVER in the frontend)
# Not needed for local development: scripts read keys from `supabase status`.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-keep-secret>
# Optional: password for `pnpm owner:add` (otherwise a random one is generated and printed once)
OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Edge Function secrets (set with `supabase secrets set ...`, never in Git)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_INITDATA_MAX_AGE_SEC=86400
# Comma-separated origins allowed to call Edge Functions (your frontend domain)
ALLOWED_ORIGINS=https://<your-frontend-domain>
